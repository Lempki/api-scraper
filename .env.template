# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# Maximum items to scrape per job, between 1 and 100.
# SCRAPER_MAX_ITEMS=100

# How long a finished job's results are kept after it finishes, in seconds. Must be greater than 0.
# SCRAPER_JOB_TTL=3600

# User-Agent string sent with scrape requests. Must not be empty.
# SCRAPER_USER_AGENT=discord-api-scraper/1.0

# How many scrapes run at once. Other jobs wait as pending. Must be at least 1.
# SCRAPER_MAX_CONCURRENT_JOBS=4

# How long one scrape may run before it is killed, in seconds. Must be greater than 0.
# SCRAPER_JOB_TIMEOUT=60

# How many jobs the in-memory store holds. Must be at least 1.
# SCRAPER_MAX_STORED_JOBS=1000

# Allows private, loopback, and link-local scrape targets for local testing.
# It must stay false in production, where it would let callers reach internal services.
# SCRAPER_ALLOW_PRIVATE_TARGETS=false
